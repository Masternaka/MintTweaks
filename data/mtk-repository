#!/usr/bin/python3 -I
"""Install only the fixed Masternaka APT source, through pkexec.

No caller-controlled paths, URLs, keys or commands are accepted. The bundled
public key is pinned by SHA-256; APT verifies the repository with Signed-By.
Existing custom files are refused, never replaced. On refresh failure only
files created by this invocation are removed.
"""

import fcntl
import hashlib
import os
from pathlib import Path
import stat
import subprocess
import sys
import tempfile

URL = "https://masternaka.github.io/masternaka-repository/"
FINGERPRINT = "86A7954635E2B4A77CAC8F00E25B26CC99FBDB1C"
KEY_SHA256 = "14b1b5852d82aafef89c8b051e26f1a06db2b48b6101722c41aab697b78e8fbf"
BUNDLED_KEY = Path(__file__).resolve().with_name("masternaka-archive-keyring.asc")
KEY_PATH = Path("/etc/apt/keyrings/masternaka.asc")
SOURCE_PATH = Path("/etc/apt/sources.list.d/masternaka.list")
LOCK_PATH = Path("/run/minttweaks-repository.lock")
SOURCE = f"deb [signed-by={KEY_PATH}] {URL} ./\n"
ENV = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LC_ALL": "C", "LANG": "C",
       "DEBIAN_FRONTEND": "noninteractive"}


def secure_directory(path):
    """Reject symlinked or user-writable system directories, including parents."""
    for parent in reversed((path, *path.parents)):
        info = parent.lstat()
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
            raise ValueError(f"Unsafe system directory: {parent}")


def existing_content(path):
    try:
        info = path.lstat()
    except FileNotFoundError:
        return None
    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
        raise ValueError(f"Unsafe existing file: {path}")
    if info.st_size > 65536:
        raise ValueError(f"Unexpected existing file: {path}")
    return path.read_bytes()


def create_file(path, content):
    """Publish a complete, readable file without overwriting an existing path."""
    descriptor, staged = tempfile.mkstemp(prefix=".minttweaks-", dir=str(path.parent))
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
            os.fchmod(stream.fileno(), 0o644)
            os.fchown(stream.fileno(), 0, 0)
        # link fails if another process created the destination in the meantime.
        os.link(staged, path)
    finally:
        os.unlink(staged)


def install_repository():
    key = BUNDLED_KEY.read_bytes()
    if hashlib.sha256(key).hexdigest() != KEY_SHA256:
        raise ValueError("The bundled public key does not match the pinned signing key.")
    secure_directory(KEY_PATH.parent.parent)
    secure_directory(SOURCE_PATH.parent)
    if not KEY_PATH.parent.exists():
        KEY_PATH.parent.mkdir(mode=0o755)
    secure_directory(KEY_PATH.parent)
    desired = ((KEY_PATH, key), (SOURCE_PATH, SOURCE.encode("ascii")))
    missing = []
    # Validate both destinations before writing either file.
    for path, content in desired:
        current = existing_content(path)
        if current is None:
            missing.append((path, content))
        elif current != content:
            raise ValueError(f"Existing configuration differs; review it manually: {path}")
        elif path.stat().st_mode & 0o444 != 0o444:
            raise ValueError(f"APT must be able to read this file: {path}")
    created = []
    try:
        for path, content in missing:
            create_file(path, content)
            created.append(path)
        print("Refreshing the signed Masternaka APT repository…", flush=True)
        completed = subprocess.run(
            ["/usr/bin/apt-get", "-o", f"Dir::Etc::sourcelist={SOURCE_PATH}",
             "-o", "Dir::Etc::sourceparts=-", "-o", "APT::Get::List-Cleanup=0",
             "-o", "APT::Update::Error-Mode=any", "-o", "Acquire::AllowInsecureRepositories=false",
             "-o", "Acquire::AllowWeakRepositories=false",
             "-o", "Acquire::AllowDowngradeToInsecureRepositories=false",
             "-o", "APT::Get::AllowUnauthenticated=false", "update"],
            env=ENV, timeout=300, check=False,
        )
        if completed.returncode:
            raise ValueError("APT refresh failed. Newly created source/key files were rolled back.")
    except Exception:
        for path in reversed(created):
            path.unlink()
        raise
    print("Masternaka repository configured and APT metadata refreshed. No packages installed.", flush=True)


def main(argv):
    if argv[1:] != ["install"]:
        print("Usage: mtk-repository install", file=sys.stderr)
        return 1
    if os.geteuid() != 0:
        print("Administrator authorization is required (pkexec).", file=sys.stderr)
        return 3
    try:
        secure_directory(LOCK_PATH.parent)
        fd = os.open(str(LOCK_PATH), os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600)
        with os.fdopen(fd, "r+") as lock:
            info = os.fstat(lock.fileno())
            if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
                raise ValueError("Unsafe repository lock file.")
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            install_repository()
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        print(f"mtk-repository: {exc}", file=sys.stderr)
        return 4
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
